!Makefile

# Build trees: ignore their contents but keep the committed .gitkeep placeholders
**/build/*
!**/build/.gitkeep

**/.DS_Store
**/*.cbp
**/Makefile
**/*.cmake
# ...but the CTest drivers are source, not generated build files
!**/tests/run_compare.cmake
!mpi/tests/run_compare.cmake
**/CMakeCache.txt
**/cmake-build-debug
**/CMakeFiles
**/Testing

.idea

**/report/*
!**/report/main.bib
!**/report/main.tex
!**/report/main.pdf
!**/report/images

compare/compare

matFact-*